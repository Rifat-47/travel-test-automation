# Copy to .env and fill in. Never commit .env.
BASE_URL=http://localhost:5173
# Where the API lives. With the local dev server this is the same as BASE_URL.
API_ORIGIN=http://localhost:5173

# Customer used by the shared login session. Must be a non-admin test account.
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=

# Test users are plus aliases of this mailbox: name+tag@domain.
TEST_MAILBOX=
