# Copy to .env and fill in. Never commit .env.
BASE_URL=http://localhost:5173

# Customer used by the shared login session. Must be a non-admin test account.
# Tests that register use plus aliases of this mailbox: name+tag@domain.
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=

# Gmail app password of the CUSTOMER_EMAIL mailbox, used to read reset emails over IMAP.
GMAIL_APP_PASSWORD=
